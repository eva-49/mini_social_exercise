{% extends "base.html.j2" %}
{% block content %}

{# Feature 1 - Design Claim 18 (Chapter 3): edit profile + own categories #}
<div class="col-md-8 mx-auto pt-4">
  <h2 class="mb-4">Edit your profile</h2>

  <!-- Bio and location -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title">About you</h5>
      <form action="{{ url_for('edit_profile') }}" method="POST">
        <input type="hidden" name="action" value="save_basic">
        <div class="mb-3">
          <label for="profile" class="form-label">Bio</label>
          <textarea class="form-control" id="profile" name="profile" rows="3">{{ user.profile or '' }}</textarea>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input type="text" class="form-control" id="location" name="location" value="{{ user.location or '' }}">
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
      </form>
    </div>
  </div>

  <!-- Existing categories -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title">Your categories ({{ fields | length }} / {{ max_fields }})</h5>
      {% if fields %}
      <ul class="list-group list-group-flush">
        {% for f in fields %}
        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
          <div><strong>{{ f.category }}:</strong> {{ f.value }}</div>
          <form action="{{ url_for('edit_profile') }}" method="POST" onsubmit="return confirm('Remove this entry?');">
            <input type="hidden" name="action" value="delete_field">
            <input type="hidden" name="field_id" value="{{ f.id }}">
            <button type="submit" class="btn btn-sm btn-danger">delete</button>
          </form>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-muted mb-0">No categories yet. Add your occupation, studies, hobbies or something of your own below.</p>
      {% endif %}
    </div>
  </div>

  <!-- Add a category -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title">Add a category</h5>
      <form action="{{ url_for('edit_profile') }}" method="POST">
        <input type="hidden" name="action" value="add_field">
        <div class="row mb-3">
          <div class="col-md-6 mb-2 mb-md-0">
            <label for="category_choice" class="form-label">Choose a category</label>
            <select class="form-select" id="category_choice" name="category_choice">
              <option value="">-- choose --</option>
              {% for s in suggestions %}
              <option value="{{ s }}">{{ s }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label for="category_custom" class="form-label">...or create your own</label>
            <input type="text" class="form-control" id="category_custom" name="category_custom" maxlength="30" placeholder="e.g. Favorite city">
          </div>
        </div>
        <div class="mb-3">
          <label for="value" class="form-label">Value</label>
          <input type="text" class="form-control" id="value" name="value" maxlength="200" required placeholder="e.g. Computer Science student">
        </div>
        <button type="submit" class="btn btn-primary" {% if fields | length >= max_fields %}disabled{% endif %}>Add</button>
      </form>
    </div>
  </div>

  <a href="/u/{{ user.username }}" class="btn btn-light mb-4">&laquo; Back to my profile</a>
</div>

{% endblock %}
