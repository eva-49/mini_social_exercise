{# Design Claim 3 (Chapter 5): small "invite friends" card on the start page.
   Included in feed.html.j2 below the to-do list. #}
{% if session.get('user_id') and page == 1 %}
{% set n = invite_count(session.get('user_id')) %}
<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h6 class="mb-1">Invite your friends</h6>
        <small class="text-muted">
          {% if n %}{{ n }} friend{{ 's' if n != 1 else '' }} joined through your link.
          {% else %}Share your personal link &ndash; friends who join follow you right away.{% endif %}
        </small>
      </div>
      <a href="{{ url_for('invite') }}" class="btn btn-primary btn-sm text-nowrap ms-3">Invite friends</a>
    </div>
  </div>
</div>
{% endif %}
